# Salin ke .env lalu sesuaikan. Jangan commit .env.

# Folder dokumen. data/dummy = persona sintetis (aman di-commit).
# Dokumen asli taruh di data/private (di-ignore git) lalu ganti ke DATA_DIR=data/private
DATA_DIR=data/dummy
STORAGE_DIR=storage

# LLM: "ollama" (lokal) atau "openai_compat" (API gratis yang kompatibel OpenAI)
LLM_PROVIDER=ollama
# qwen3:4b-instruct (2,5 GB) muat di VRAM 4 GB dan tidak memakai mode thinking.
LLM_MODEL=qwen3:4b-instruct
LLM_BASE_URL=http://localhost:11434
# Hanya untuk openai_compat. Kosongkan untuk Ollama.
LLM_API_KEY=
TEMPERATURE=0
# Kosongkan untuk model tanpa mode thinking (mis. qwen3:4b-instruct).
# Isi "false" untuk mematikan thinking di qwen3.5 / gemma4 (lebih cepat).
LLM_THINK=
# Cek relevansi: LLM dipanggil sekali lagi untuk menilai apakah jawaban membahas hal yang ditanyakan.
# Menambah waktu per jawaban; set false untuk mematikan. RELEVANCE_MODEL kosong = pakai LLM_MODEL.
RELEVANCE_CHECK=true
RELEVANCE_MODEL=

# Embedding lewat Ollama
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_BASE_URL=http://localhost:11434
# Instruksi query untuk Qwen3-Embedding (dokumen tidak diberi instruksi).
# Kosongkan kalau ganti ke model embedding yang tidak memakai instruksi (mis. bge-m3).
EMBED_QUERY_INSTRUCTION=Given a question about a job applicant, retrieve passages from the applicant's documents that answer it

# Retrieval: hybrid | bm25 | vector
RETRIEVAL_MODE=hybrid
TOP_K=5
MAX_CHUNK_CHARS=1200
MAX_CONTEXT_CHARS=6000
REQUEST_TIMEOUT=120
